#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

extra_command "hot_reload" "Hot-reload service"

CONF="honk"
PROG="/usr/bin/honk-core"
HONK_HOST_IFACE="dae0"
HONK_PEER_IFACE="dae0peer"
HONK_NETNS_NAME="daens"
HONK_NETNS_PATH="/run/netns/$HONK_NETNS_NAME"

LOG_DIR="/var/log/honk"
LOG_FILE="$LOG_DIR/honk.log"

# /etc/honk 下是配置文件（可能含节点/订阅凭据）：目录 750、文件 640。
# 不能对目录也用 640 —— 目录缺执行位就无法进入/遍历，会直接把配置读坏。
# /etc/honk/state 是 honk 自己管理的运行时状态子树（含 honk.db），必须排除在递归收紧之外：
# honk 要求该目录 0700、其中文件 0600、且属主为运行 uid，否则启动即致命错误
# "state database: state database path is unsafe"（见 honk-core/src/state.rs 的 private()：
# mode & 0o077 != 0 即判 unsafe）。本函数每次启动都跑，若递归改到它，
# 首次启动（目录尚不存在、由 honk 按 0700 自建）能过，之后每次重启都会失败。
STATE_DIR_PATH="/etc/honk/state"
harden_conf_perms() {
    mkdir -p /etc/honk/config.d
    # 兜底纠正：历史版本可能已把它改成 750/640，残留权限会一直卡住启动
    if [ -d "$STATE_DIR_PATH" ]; then
        find "$STATE_DIR_PATH" -type d -exec chmod 700 {} \; 2>/dev/null || true
        find "$STATE_DIR_PATH" -type f -exec chmod 600 {} \; 2>/dev/null || true
    fi
    find /etc/honk -path "$STATE_DIR_PATH" -prune -o -type d -exec chmod 750 {} \; 2>/dev/null || true
    find /etc/honk -path "$STATE_DIR_PATH" -prune -o -type f -exec chmod 640 {} \; 2>/dev/null || true
}

cleanup_netns() {
    ip netns del "$HONK_NETNS_NAME" 2>/dev/null || true
    umount "$HONK_NETNS_PATH" 2>/dev/null || true
    rm -f "$HONK_NETNS_PATH" 2>/dev/null || true
    ip link del "$HONK_HOST_IFACE" 2>/dev/null || true
    ip link del "$HONK_PEER_IFACE" 2>/dev/null || true
}

rotate_log() {
    mkdir -p "$LOG_DIR"
    chmod 755 "$LOG_DIR"

    if [ -f "$LOG_FILE" ]; then
        [ -f "$LOG_FILE.3" ] && rm -f "$LOG_FILE.3"
        [ -f "$LOG_FILE.2" ] && mv "$LOG_FILE.2" "$LOG_FILE.3"
        [ -f "$LOG_FILE.1" ] && mv "$LOG_FILE.1" "$LOG_FILE.2"
        mv "$LOG_FILE" "$LOG_FILE.1"
    fi

    : > "$LOG_FILE"
    chmod 640 "$LOG_FILE"
}

start_service() {
    local enabled config_file

    config_load "$CONF"
    config_get_bool enabled "config" "enabled" "0"
    [ "$enabled" -eq "1" ] || return 1

    rotate_log

    config_get config_file "config" "config_file" "/etc/honk/config.dae"

    harden_conf_perms
    cleanup_netns

    procd_open_instance "$CONF"
    procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray"
    procd_set_param command "$PROG" --config "$config_file"
    procd_set_param netdev "$HONK_HOST_IFACE" "$HONK_PEER_IFACE"
    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param term_timeout 8
    procd_set_param respawn 3600 5 5
    procd_set_param stderr 1
    procd_close_instance
}

service_stopped() {
    cleanup_netns
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}

hot_reload() {
    harden_conf_perms
    /etc/init.d/honk running && "$PROG" reload
}

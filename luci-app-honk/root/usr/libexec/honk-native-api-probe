#!/bin/sh
#
# 供 LuCI 的「WebUI」页决定「能否把面板嵌进页面」，输出 JSON。
# 由 htdocs/luci-static/resources/view/honk/webui.js 通过 fs.exec_direct 调用。
#
# 为什么探测必须放在路由器侧：
#   1) honk 的 GET /api（discovery）默认不发 CORS 头，浏览器从 LuCI 的源跨源请求会被拦；
#   2) 更要紧的是 —— **iframe 被 X-Frame-Options 拒绝时是浏览器静默行为**，页面里的 JS
#      拿不到任何错误（onload 甚至可能照常触发），所以"能不能嵌"只能在服务端读响应头来判断。
#      本脚本因此多回一个 framing 字段：读 /ui/ 的响应头里有没有 X-Frame-Options。
#      （`ca465bcc0` 起 honk 已删掉该头以支持被 LuCI 嵌入；更早的二进制仍会发 DENY。）
#
# 只用 shell + awk/sed + 一个 HTTP 客户端（busybox wget 或 uclient-fetch），不依赖 PATH 上的其它命令。
# discovery/响应头原文不在这里解析 JSON，由 JS 用 JSON.parse 处理。

CFG=/etc/honk/config.d/api.dae

# 取出 native_api 块（按花括号配平），避免误取 clash_api 里的同名字段（如 cache_file.enabled）
native_block() {
	[ -r "$CFG" ] || return 0

	awk '
		!inside && $0 ~ /(^|[^A-Za-z_])native_api[[:space:]]*\{/ { inside = 1 }
		inside {
			open  = gsub(/\{/, "{")
			close = gsub(/\}/, "}")
			depth += open - close
			print
			if (depth <= 0) exit
		}
	' "$CFG"
}

# 从 native_api 块里取 <key>: <value>，去掉引号、行尾注释与空白
field() {
	printf '%s\n' "$BLOCK" \
		| sed -n "s/^[[:space:]]*$1[[:space:]]*:[[:space:]]*//p" \
		| head -n 1 \
		| sed "s/[[:space:]]*#.*$//; s/^'//; s/'$//; s/^\"//; s/\"$//; s/[[:space:]]*$//"
}

# 普通抓取（只判可达）
fetch() {
	if command -v wget >/dev/null 2>&1; then
		wget -q -O - -T 3 "$1" 2>/dev/null
	elif command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -O - -T 3 "$1" 2>/dev/null
	fi
}

# 抓取并把**响应头**也打出来（-S）。不支持 -S 的客户端会输出空，属预期：此时 framing 记为 unknown。
fetch_head() {
	if command -v wget >/dev/null 2>&1; then
		wget -S -q -O /dev/null -T 3 "$1" 2>&1 | tr -d '\r'
	elif command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -S -q -O /dev/null -T 3 "$1" 2>&1 | tr -d '\r'
	fi
}

if [ -r "$CFG" ]; then
	present=true
else
	present=false
fi

BLOCK=$(native_block)

enabled=$(field enabled)
listen=$(field listen)
ui=$(field ui)

[ -n "$enabled" ] || enabled=false
[ -n "$listen" ] || listen="127.0.0.1:9527"

port="${listen##*:}"
url="http://127.0.0.1:$port/ui/"

reachable=false
body=""
framing=unknown

if [ "$enabled" = "true" ] && [ -n "$ui" ]; then
	body=$(fetch "$url")

	if [ -n "$body" ]; then
		reachable=true

		head=$(fetch_head "$url")

		if [ -n "$head" ]; then
			if printf '%s' "$head" | grep -qi '^[[:space:]]*x-frame-options:'; then
				framing=deny
			else
				framing=ok
			fi
		fi
	fi
fi

printf '{"configured":{"present":%s,"enabled":%s,"listen":"%s","ui":"%s"},"probe":{"reachable":%s,"framing":"%s"}}\n' \
	"$present" "$enabled" "$listen" "$ui" "$reachable" "$framing"

#!/bin/sh
[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || exit 0
[ "$ACTION" = "ifupdate" ] && [ -z "$IFUPDATE_ADDRESSES" ] && [ -z "$IFUPDATE_DATA" ] && exit 0
. /lib/functions/network.sh
network_flush_cache
network_find_wan NET_IF
[ "$(uci -q get honk.config.enabled)" = "1" ] || exit 0
ROUTE_FILE="/etc/honk/config.d/route.dae"
for m in AUTO_WAN4_IP AUTO_WAN6_IP AUTO_LAN6_IP; do
grep -q "# $m" "$ROUTE_FILE" 2>/dev/null || exit 0
done
WAN_DEV="$DEVICE"
[ -z "$WAN_DEV" ] && network_get_device WAN_DEV "$NET_IF" 2>/dev/null
[ -z "$WAN_DEV" ] && WAN_DEV="$NET_IF"
LAN_DEV=""
network_get_device LAN_DEV "lan" 2>/dev/null
[ -z "$LAN_DEV" ] && LAN_DEV="br-lan"
[ -n "$DEVICE" ] && [ "$DEVICE" != "$WAN_DEV" ] && [ "$DEVICE" != "$LAN_DEV" ] && exit 0
WAN4=$(ip -o -4 addr show dev "$WAN_DEV" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
WAN6=$(ip -o -6 addr show dev "$WAN_DEV" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -Ev '^(fe80|f[cd])' | head -1)
[ -z "$WAN6" ] && WAN6=$(ubus call network.interface.wan6 status 2>/dev/null | jsonfilter -e '@.ipv6-address[0].address')
LAN6=$(ip -o -6 addr show dev "$LAN_DEV" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -Ev '^(fe80|f[cd])' | head -1)
[ -z "$LAN6" ] && LAN6=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@.ipv6-address[0].address')
wan4_line="    dip($WAN4) -> direct(must)  # AUTO_WAN4_IP"
wan6_line="    dip($WAN6) -> direct(must)  # AUTO_WAN6_IP"
lan6_line="    dip($LAN6) -> direct(must)  # AUTO_LAN6_IP"
DEBOUNCE_FILE="/tmp/run/honk_hotplug_gen"
mkdir -p /tmp/run
my_gen="$$.$(date +%s)"
echo "$my_gen" > "$DEBOUNCE_FILE"
(
sleep 5
[ "$(cat "$DEBOUNCE_FILE" 2>/dev/null)" = "$my_gen" ] || exit 0
TMP=$(mktemp)
awk -v w4="$wan4_line" -v w6="$wan6_line" -v l6="$lan6_line" '
  /# AUTO_WAN4_IP/ { print w4; next }
  /# AUTO_WAN6_IP/ { print w6; next }
  /# AUTO_LAN6_IP/ { print l6; next }
  { print }
' "$ROUTE_FILE" > "$TMP"
mv "$TMP" "$ROUTE_FILE"
/etc/init.d/honk running && /etc/init.d/honk hot_reload
) &

msgstr "节点设置"

msgid "Routing Settings"
msgstr "路由设置"

msgid "Global Configuration"
msgstr "全局配置"

msgid "DNS Configuration"
msgstr "DNS 配置"

msgid "Node Configuration"
msgstr "节点配置"

msgid "Route Configuration"
msgstr "路由配置"

msgid "Configure global settings for HONK."
msgstr "调整 HONK 的全局设置。"

msgid "Configure DNS settings for HONK."
msgstr "调整 HONK 的 DNS 设置。"

msgid "Configure nodes and groups for HONK."
msgstr "调整 HONK 的节点与分组设置。"

msgid "Configure routing rules for HONK."
msgstr "调整 HONK 的路由规则。"

msgid "Correctly configure the include field for separate-config to work, or enter complete configuration here."
msgstr "请正确配置 include 字段以启用拆分配置，或在此处填写完整配置。"

msgid "Logs"
msgstr "日志"

msgid "Scroll to bottom"
msgstr "滚动到底部"

msgid "Scroll to top"
msgstr "滚动到顶部"

msgid "Memory Usage"
msgstr "内存占用"

msgid "Format Code"
msgstr "格式化代码"

msgid "Configuration"
msgstr "配置"

msgid "Unable to read %s: %s"
msgstr "无法读取 %s：%s"

msgid "Configuration saved. Use %s to apply it."
msgstr "配置已保存，点「%s」使其生效。"

msgid "Editor unavailable, plain textarea is used: %s"
msgstr "编辑器不可用，已退回普通文本框：%s"

msgid "Service reloaded successfully"
msgstr "服务重载成功"

msgid "Reload failed: %s"
msgstr "重载失败：%s"

msgid "API Configuration"
msgstr "API 配置"

msgid "Restart Now"
msgstr "立即重启"

msgid "Restart Service"
msgstr "重启服务"

msgid "Restart failed: %s"
msgstr "重启失败：%s"

msgid "Service restarted successfully"
msgstr "服务重启成功"

msgid "API Settings"
msgstr "API 设置"

msgid "Configure the native API listener. Saving requires a service restart to take effect."
msgstr "配置原生 API 监听。保存后需重启服务方可生效。"

msgid "Open API Settings"
msgstr "打开 API 设置"

msgid "Open Global Settings"
msgstr "打开全局设置"

msgid "The honk service is disabled. Enable it on the Global Settings page."
msgstr "honk 服务已停用，请到「全局设置」页启用。"

msgid "Unable to read the native API status: %s"
msgstr "无法读取原生 API 状态：%s"

msgid "WebUI"
msgstr "WebUI"

msgid "No Web UI is configured. Set ui to embedded to serve the built-in doona panel."
msgstr "未配置 Web UI。把 ui 设为 embedded 即可直接用内嵌的 doona 面板。"

msgid "No native API configuration file was found. Create one on the API Settings page."
msgstr "未找到原生 API 配置文件，请到「API 设置」页创建一个。"

msgid "The native API listener is disabled, so nothing is served."
msgstr "原生 API 监听未启用，因此没有内容可托管。"

msgid "The panel is not reachable. native_api settings only take effect after a service restart."
msgstr "面板连不上。native_api 的字段只有重启服务后才生效。"

msgid "This build refuses to be embedded (X-Frame-Options: DENY), so the frame would stay blank. Use a build from ca465bcc0 or later."
msgstr "此二进制拒绝被内嵌（X-Frame-Options: DENY），内嵌会是一片空白。请改用 ca465bcc0 之后的构建。"

msgid "Unable to determine the panel address from the native API configuration."
msgstr "无法从原生 API 配置里确定面板地址。"

msgid "unparsable probe output"
msgstr "探测输出无法解析"

msgid "The configuration file has no effective native_api block — it is most likely commented out. Uncomment it and set a secret, then restart the service."
msgstr "配置文件里没有生效的 native_api 块 —— 多半是整段被注释掉了。取消注释并填好 secret，然后重启服务。"
